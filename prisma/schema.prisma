generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum GoalType {
  MONTHLY_PROFIT
  WEEKLY_PROFIT
  YEARLY_PROFIT
  MAX_DRAWDOWN
  WIN_RATE
  MONTHLY_TRADE_COUNT
  WEEKLY_TRADE_COUNT
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  password         String
  name             String?
  role             Role       @default(USER)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @default(now()) @updatedAt
  resetToken       String?
  resetTokenExpiry DateTime?
  disabled         Boolean    @default(false)
  testFlag         Boolean    @default(false)
  accounts         Account[]
}

model Account {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  dailyTradeLimit Int        @default(50)
  dailyEditCount  Int        @default(0)
  editCountDate   String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now()) @updatedAt
  strategies      Strategy[]
  trades          Trade[]
  goals           Goal[]

  @@index([userId])
}

model Goal {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type      GoalType
  value     Float
  createdAt DateTime @default(now())

  @@unique([accountId, type])
  @@index([accountId])
}

model Strategy {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  description String?
  confluences String[]
  questions   Json     @default("[]")
  trades      Trade[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([accountId])
}

model Trade {
  id          String       @id @default(cuid())
  accountId   String
  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  strategyId  String
  strategy    Strategy     @relation(fields: [strategyId], references: [id])
  date        DateTime     @db.Date
  instrument  String
  direction   String
  session     String
  entryTime   String
  exitTime    String
  exitDate    String?
  result      String
  pnl         Float
  riskAmount  Float
  grade       String
  gradeOrder  Int          @default(0)
  confluences String[]
  answers     Json         @default("[]")
  notes       String?
  archived    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  @@index([accountId])
  @@index([accountId, archived])
  @@index([accountId, date])
  @@index([accountId, gradeOrder])
  @@index([accountId, pnl])
  @@index([strategyId])
}

model Image {
  id           String   @id @default(cuid())
  entityType   String
  entityId     String
  imageKey     String   @unique
  thumbnailKey String   @unique
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
}

model EconomicEvent {
  id        String   @id @default(cuid())
  title     String
  country   String
  date      DateTime
  impact    String
  forecast  String?
  previous  String?
  actual    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([date, title, country])
  @@index([date, country])
  @@index([country])
  @@index([impact])
  @@index([date])
}
