generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  password         String
  name             String?
  role             Role       @default(USER)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @default(now()) @updatedAt
  resetToken       String?
  resetTokenExpiry DateTime?
  disabled         Boolean    @default(false)
  testFlag         Boolean    @default(false)
  dailyEditCount   Int        @default(0)
  editCountDate    String?
  strategies       Strategy[]
  trades           Trade[]
}

model Strategy {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  confluences String[]
  questions   Json     @default("[]")
  trades      Trade[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([userId])
}

model Trade {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyId  String
  strategy    Strategy     @relation(fields: [strategyId], references: [id])
  date        DateTime     @db.Date
  instrument  String
  direction   String
  session     String
  entryTime   String
  exitTime    String
  exitDate    String?
  result      String
  pnl         Float
  riskAmount  Float
  grade       String
  gradeOrder  Int          @default(0)
  confluences String[]
  answers     Json         @default("[]")
  notes       String?
  archived    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  @@index([userId])
  @@index([userId, archived])
  @@index([userId, date])
  @@index([userId, gradeOrder])
  @@index([userId, pnl])
  @@index([strategyId])
}

model Image {
  id           String   @id @default(cuid())
  entityType   String
  entityId     String
  imageKey     String   @unique
  thumbnailKey String   @unique
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
}
